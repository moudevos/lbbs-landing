{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lbbs-landing-astro",
    "src/lib/analytics/analytics-calculations.ts",
    "src/lib/customers/customer-product-discount.ts",
    "src/lib/customers/import.ts",
    "src/lib/reservations/mapper.ts",
    "src/lib/storage/upload-image.ts",
    "src/components/analytics/analytics-dashboard.tsx",
    "src/components/reservations/reservation-board.tsx",
    "src/components/reservations/reservation-status-flow.tsx"
  ]
}
